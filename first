		def neural_network(inputs, weights):
    intermediate = []

    for i in range(len(inputs)):
        result = inputs[i] * weights[i]
        intermediate.append(result)

    prediction = sum(intermediate)

    return prediction, intermediate


inputs = [2, 3, 4]
weights = [0.5, 0.2, 0.3]

